rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isServerAuth(val) {
      return val is string && val == 'bt_srv_auth_8f4c29a7d1e63b0594127a6c8e3d9f1b';
    }

    function isAdminChannel(val) {
      return val is string && val == 'bt_adm_ch_3e91b5c47a08d2f61495b3c7e0a2d84f';
    }

    function jstTime() {
      return request.time + duration.value(9, 'h');
    }

    function isValidSurvey(data) {
      return data.keys().hasAll(['visitorId', 'authorName', 'content', 'isAdminVerified', 'adminChannel', 'createdAt']) &&
        data.keys().hasOnly(['visitorId', 'authorName', 'content', 'isAdminVerified', 'adminChannel', 'createdAt']) &&
        isValidId(data.visitorId) &&
        data.authorName is string &&
        data.authorName.size() >= 1 &&
        data.authorName.size() <= 20 &&
        data.content is string &&
        data.content.size() >= 1 &&
        data.content.size() <= 300 &&
        data.isAdminVerified is bool &&
        isAdminChannel(data.adminChannel) &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    function isValidSurveyQuota(data, visitorId) {
      let jst = jstTime();
      return data.keys().hasAll(['visitorId', 'year', 'month', 'day', 'count', 'lastSurveyId', 'serverAuth', 'updatedAt']) &&
        data.keys().hasOnly(['visitorId', 'year', 'month', 'day', 'count', 'lastSurveyId', 'serverAuth', 'updatedAt']) &&
        isValidId(data.visitorId) &&
        data.visitorId == visitorId &&
        data.year is int &&
        data.month is int &&
        data.day is int &&
        data.year == jst.year() &&
        data.month == jst.month() &&
        data.day == jst.day() &&
        data.count is int &&
        data.count >= 1 &&
        data.count <= 3 &&
        isValidId(data.lastSurveyId) &&
        isServerAuth(data.serverAuth) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isSameJstDay(oldData) {
      let jst = jstTime();
      return oldData.year == jst.year() &&
        oldData.month == jst.month() &&
        oldData.day == jst.day();
    }

    function isQuotaBatchSynchronized(surveyId, visitorId) {
      let quotaAfter = getAfter(/databases/$(database)/documents/surveyQuotas/$(visitorId)).data;
      return quotaAfter.visitorId == visitorId &&
        isServerAuth(quotaAfter.serverAuth) &&
        quotaAfter.updatedAt == request.time &&
        quotaAfter.lastSurveyId == surveyId &&
        quotaAfter.count >= 1 &&
        quotaAfter.count <= 3;
    }

    function isValidAdmin(data, visitorId) {
      return data.keys().hasAll(['visitorId', 'username', 'verified', 'serverAuth', 'verifiedAt', 'updatedAt']) &&
        data.keys().hasOnly(['visitorId', 'username', 'verified', 'serverAuth', 'verifiedAt', 'updatedAt']) &&
        isValidId(data.visitorId) &&
        data.visitorId == visitorId &&
        data.username is string &&
        data.username.size() >= 1 &&
        data.username.size() <= 20 &&
        data.verified is bool &&
        isServerAuth(data.serverAuth) &&
        data.verifiedAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPresenceGate(data, visitorId) {
      return data.keys().hasAll(['visitorId', 'serverAuth', 'updatedAt']) &&
        data.keys().hasOnly(['visitorId', 'serverAuth', 'updatedAt']) &&
        isValidId(data.visitorId) &&
        data.visitorId == visitorId &&
        isServerAuth(data.serverAuth) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPresence(data, visitorId) {
      return data.keys().hasAll(['visitorId', 'username', 'isAdminVerified', 'dayKey', 'isOnline', 'presenceScope', 'lastLoginAt', 'lastSeenAt']) &&
        data.keys().hasOnly(['visitorId', 'username', 'isAdminVerified', 'dayKey', 'isOnline', 'presenceScope', 'lastLoginAt', 'lastSeenAt']) &&
        isValidId(data.visitorId) &&
        data.visitorId == visitorId &&
        data.username is string &&
        data.username.size() >= 1 &&
        data.username.size() <= 20 &&
        data.isAdminVerified is bool &&
        data.dayKey is string &&
        data.dayKey.size() == 10 &&
        data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.isOnline is bool &&
        data.presenceScope is string &&
        data.presenceScope == 'public_lobby' &&
        data.lastLoginAt is timestamp &&
        data.lastSeenAt is timestamp &&
        data.lastSeenAt == request.time;
    }

    function isPresenceGateSynchronized(visitorId) {
      let gateAfter = getAfter(/databases/$(database)/documents/presenceGates/$(visitorId)).data;
      return gateAfter.visitorId == visitorId &&
        isServerAuth(gateAfter.serverAuth) &&
        gateAfter.updatedAt == request.time;
    }

    // Connection validation probe (get only for exact 'connection' doc)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // Admin registry (never get-able directly, server-gated list & write)
    match /admins/{visitorId} {
      allow get: if false;
      allow list: if resource.data.serverAuth == 'bt_srv_auth_8f4c29a7d1e63b0594127a6c8e3d9f1b';
      allow create: if isValidId(visitorId) &&
        isValidAdmin(incoming(), visitorId) &&
        incoming().verifiedAt == request.time;
      allow update: if isValidId(visitorId) &&
        isValidAdmin(incoming(), visitorId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['username', 'verified', 'updatedAt']) &&
        incoming().visitorId == existing().visitorId &&
        incoming().serverAuth == existing().serverAuth &&
        incoming().verifiedAt == existing().verifiedAt;
      allow delete: if false;
    }

    // Per-visitor daily JST survey quota (max 3 per day, 1 survey per atomic batch)
    match /surveyQuotas/{visitorId} {
      allow get: if false;
      allow list: if resource.data.serverAuth == 'bt_srv_auth_8f4c29a7d1e63b0594127a6c8e3d9f1b';
      allow create: if isValidId(visitorId) &&
        isValidSurveyQuota(incoming(), visitorId) &&
        incoming().count == 1;
      allow update: if isValidId(visitorId) &&
        isValidSurveyQuota(incoming(), visitorId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['year', 'month', 'day', 'count', 'lastSurveyId', 'updatedAt']) &&
        incoming().visitorId == existing().visitorId &&
        incoming().serverAuth == existing().serverAuth &&
        (
          (isSameJstDay(existing()) && incoming().count == existing().count + 1 && incoming().count <= 3) ||
          (!isSameJstDay(existing()) && incoming().count == 1)
        );
      allow delete: if false;
    }

    // Survey submissions: atomic write gated by server quota batch; real-time list gated by adminChannel
    match /surveys/{surveyId} {
      allow get: if false;
      allow list: if resource.data.adminChannel == 'bt_adm_ch_3e91b5c47a08d2f61495b3c7e0a2d84f';
      allow create: if isValidId(surveyId) &&
        isValidSurvey(incoming()) &&
        isQuotaBatchSynchronized(surveyId, incoming().visitorId);
      allow update, delete: if false;
    }

    // Server-only presence write gate (never readable by browsers)
    match /presenceGates/{visitorId} {
      allow get, list: if false;
      allow create: if isValidId(visitorId) &&
        isValidPresenceGate(incoming(), visitorId);
      allow update: if isValidId(visitorId) &&
        isValidPresenceGate(incoming(), visitorId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']) &&
        incoming().visitorId == existing().visitorId &&
        incoming().serverAuth == existing().serverAuth;
      allow delete: if false;
    }

    // Real-time online & daily JST login presence (server batch OR unprivileged browser fallback)
    match /presence/{visitorId} {
      allow get: if false;
      allow list: if resource.data.presenceScope == 'public_lobby';
      allow create: if isValidId(visitorId) &&
        isValidPresence(incoming(), visitorId) &&
        incoming().lastLoginAt == request.time &&
        (isPresenceGateSynchronized(visitorId) || incoming().isAdminVerified == false);
      allow update: if isValidId(visitorId) &&
        isValidPresence(incoming(), visitorId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['username', 'isAdminVerified', 'dayKey', 'isOnline', 'lastLoginAt', 'lastSeenAt']) &&
        incoming().visitorId == existing().visitorId &&
        incoming().presenceScope == existing().presenceScope &&
        ((incoming().dayKey == existing().dayKey && incoming().lastLoginAt == existing().lastLoginAt) ||
          (incoming().dayKey != existing().dayKey && incoming().lastLoginAt == request.time)) &&
        (isPresenceGateSynchronized(visitorId) || incoming().isAdminVerified == existing().isAdminVerified);
      allow delete: if false;
    }
  }
}
